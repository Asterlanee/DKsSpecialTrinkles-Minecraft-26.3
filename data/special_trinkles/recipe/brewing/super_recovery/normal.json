{
  "type": "minecraft:brewing",
  "input": {
    "item": "minecraft:potion",
    "potion_contents": {
      "effects": {
        "contains": [
          {
            "minecraft:instant_health": {
              "amplifier": 2
            }
          }
        ],
        "size": 1
      }
    }
  },
  "output": {
    "id": "minecraft:potion",
    "components": {
      "minecraft:custom_name": {
        "text": "超级回复药水",
        "color": "#00e000",
        "italic": false
      },
      "minecraft:enchantment_glint_override": true,
      "minecraft:potion_contents": {
        "custom_color": 160000,
        "custom_effects": [
          {
            "id": "minecraft:instant_health",
            "amplifier": 2,
            "duration": 1
          },
          {
            "id": "minecraft:saturation",
            "amplifier": 4,
            "duration": 1,
            "show_particles": false,
            "show_icon": false
          }
        ]
      }
    }
  },
  "reagent": {
    "item": "minecraft:cake"
  }
}